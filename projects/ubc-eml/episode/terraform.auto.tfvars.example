# Copy this file to `terraform.auto.tfvars` and fill in values for your project.
# `terraform.auto.tfvars` is committed (no secrets), so the project's settings
# travel with the code.
#
# DO NOT put AWS credentials or any other secrets here. Set those as sensitive
# environment variables in the HCP workspace instead.

client_name  = "example-client"
project_name = "example-project"
environment  = "dev"
aws_region   = "ca-central-1"

# Set to ca-central-1 for the Canada-only Aurora deployment.
# Terraform creates the VPC and private subnets for the database.
enable_episode_database       = true
database_vpc_cidr             = "10.42.0.0/16"
database_availability_zones   = ["ca-central-1a", "ca-central-1b"]
database_private_subnet_cidrs = ["10.42.1.0/24", "10.42.2.0/24"]

tags = {
  Owner       = "media-lab"
  CostCenter  = "research-internal"
}

cognito_callback_urls = [
  "http://localhost:5173/auth/callback",
  "https://public.example.com/auth/callback"
]

cognito_logout_urls = [
  "http://localhost:5173/",
  "https://public.example.com/"
]
